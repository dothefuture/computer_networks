        </mxCell>
        <mxCell id="5-1zp4KCR5sD29i6IIJs-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" value="Атака MAC-overflow&#xa;(Злоумышленник забивает&#xa;память генерацией тысяч&#xa;ложных MAC-адресов)" vertex="1">
