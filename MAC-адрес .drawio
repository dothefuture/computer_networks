        <mxCell id="5-1zp4KCR5sD29i6IIJs-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fad7ac;strokeColor=#b46504;fontStyle=1;align=center;fontSize=12;" value="ПРОБЛЕМА&#xa;&#xa;Флуд неизвестного одноадресного&#xa;трафика (Unicast Flooding)&#xa;внутри коммутатора L2" vertex="1">
          <mxGeometry height="80" width="240" x="570" y="960" as="geometry" />
        </mxCell>
